<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WcfService1</AssemblyName>
    <RootNamespace>eShopWCFService</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude misplaced client-side proxy (dead code, uses System.ServiceModel.ClientBase) -->
    <Compile Remove="CatalogServiceClient.cs" />
    <!-- Exclude legacy IIS/WAS service activation file -->
    <Content Remove="CatalogService.svc" />
  </ItemGroup>

  <ItemGroup>
    <!-- CoreWCF server-side hosting -->
    <PackageReference Include="CoreWCF.Primitives" Version="1.9.1" />
    <PackageReference Include="CoreWCF.Http" Version="1.9.1" />
    <PackageReference Include="CoreWCF.ConfigurationManager" Version="1.9.1" />

    <!-- EF Core 10 (matches target net10.0) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
