<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>eShopWinForms</RootNamespace>
    <AssemblyName>eShopWinForms</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Suppress CA1416 platform compatibility: entire project is net10.0-windows (Windows-only by design).
         Suppress CS0108 (hiding without new) and CS0169 (unused field) in auto-generated Reference.cs / Designer.cs. -->
    <NoWarn>$(NoWarn);CA1416;CS0108;CS0169</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- WCF client packages for consuming the WCF service (replaces CoreWCF which is server-only) -->
    <PackageReference Include="System.ServiceModel.Primitives" Version="8.1.0" />
    <PackageReference Include="System.ServiceModel.Http" Version="8.1.0" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Connected Services\eShopServiceReference\Reference.cs">
