<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WcfService1</AssemblyName>
    <RootNamespace>eShopWCFService</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude legacy files not needed in SDK-style project -->
    <Compile Remove="CatalogServiceClient.cs" />
    <Compile Remove="Properties\AssemblyInfo.cs" />
    <!-- Exclude the .svc code-behind pattern – service lives in CatalogService.svc.cs which is fine,
         but we rename the class file usage. The .svc file itself is not compiled. -->
    <Content Remove="CatalogService.svc" />
    <None Remove="Web.config" />
    <None Remove="Web.Debug.config" />
    <None Remove="Web.Release.config" />
    <None Remove="packages.config" />
  </ItemGroup>

  <ItemGroup>
    <!-- CoreWCF server packages – 1.9.1 is the current stable non-vulnerable release -->
    <PackageReference Include="CoreWCF.Primitives" Version="1.9.1" />
    <PackageReference Include="CoreWCF.Http" Version="1.9.1" />
    <!-- EF Core – match major version to target runtime (net10.0 → 10.0.x) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
