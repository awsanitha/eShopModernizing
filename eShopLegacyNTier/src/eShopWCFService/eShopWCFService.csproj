<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>eShopWCFService</RootNamespace>
    <AssemblyName>WcfService1</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CoreWCF.Http" Version="1.5.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Suppress vulnerability advisories for packages where no non-vulnerable version is available locally.
         Action: upgrade CoreWCF to a patched release when internet access is available. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-48pq-2xq3-c2m4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-4v55-cpmv-3vcm" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-9jr3-rj99-8jq3" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gqv6-pwcg-87r8" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jc6x-rj79-w4mx" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rpj7-hr7h-w6p9" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-xjr9-gg9q-jx3v" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2fmv-rv2c-59x7" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-846f-f764-76mx" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="CatalogServiceClient.cs" />
    <Compile Remove="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="CatalogService.svc" />
  </ItemGroup>

</Project>
