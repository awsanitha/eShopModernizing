<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>eShopWCFService</RootNamespace>
    <AssemblyName>WcfService1</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude the legacy CatalogServiceClient stub — not needed on the server project -->
    <Compile Remove="CatalogServiceClient.cs" />
    <!-- Exclude the legacy .svc code-behind file; replaced by Program.cs routing -->
    <Compile Remove="CatalogService.svc.cs" />
    <!-- Exclude .svc endpoint file — not used with CoreWCF hosting -->
    <Content Remove="CatalogService.svc" />
    <!-- Exclude legacy web config transforms -->
    <None Remove="Web.Debug.config" />
    <None Remove="Web.Release.config" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CoreWCF.Primitives" Version="1.9.1" />
    <PackageReference Include="CoreWCF.Http" Version="1.9.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
