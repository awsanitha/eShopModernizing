<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WcfService1</AssemblyName>
    <RootNamespace>WcfService1</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CoreWCF.Primitives" Version="1.6.0" />
    <PackageReference Include="CoreWCF.Http" Version="1.6.0" />
    <PackageReference Include="EntityFramework" Version="6.5.1" />
  </ItemGroup>

  <!-- Exclude legacy web/config files not needed in .NET 10 -->
  <ItemGroup>
    <None Remove="CatalogService.svc" />
    <!-- CatalogServiceClient is a legacy WCF client stub in the server project; excluded as the server uses CoreWCF -->
    <Compile Remove="CatalogServiceClient.cs" />
  </ItemGroup>

</Project>
