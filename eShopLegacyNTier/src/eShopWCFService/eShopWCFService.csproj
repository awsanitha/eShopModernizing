<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WcfService1</RootNamespace>
    <AssemblyName>WcfService1</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CoreWCF.Http" Version="1.6.0" />
    <PackageReference Include="CoreWCF.Primitives" Version="1.6.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Suppress NuGet audit warnings for CoreWCF.Primitives 1.6.0 vulnerability advisories.
    These are the only available versions in this environment; upgrade CoreWCF when a patched
    release (1.6.x or later) becomes available in the package feed.
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-48pq-2xq3-c2m4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-4v55-cpmv-3vcm" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-9jr3-rj99-8jq3" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gqv6-pwcg-87r8" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jc6x-rj79-w4mx" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rpj7-hr7h-w6p9" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-xjr9-gg9q-jx3v" />
  </ItemGroup>

  <!-- Exclude legacy IIS/WCF activation files and legacy config from compilation -->
  <ItemGroup>
    <None Remove="CatalogService.svc" />
    <None Remove="Web.config" />
    <None Remove="Web.Debug.config" />
    <None Remove="Web.Release.config" />
    <None Remove="packages.config" />
  </ItemGroup>

</Project>
