<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WcfService1</RootNamespace>
    <AssemblyName>WcfService1</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <!-- Enable implicit usings so WebApplication/builder types resolve without manual using directives -->
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Exclude legacy IIS-hosted WCF files and the duplicate client stub -->
  <ItemGroup>
    <Compile Remove="CatalogServiceClient.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="CatalogService.svc" />
    <Content Remove="Web.config" />
    <Content Remove="Web.Debug.config" />
    <Content Remove="Web.Release.config" />
  </ItemGroup>

  <ItemGroup>
    <!-- CoreWCF replaces System.ServiceModel server-side hosting -->
    <PackageReference Include="CoreWCF.Http" Version="1.9.1" />
    <!-- EF Core 10 for net10.0 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
  </ItemGroup>
</Project>
