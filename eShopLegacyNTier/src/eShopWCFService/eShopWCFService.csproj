<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>eShopWCFService</RootNamespace>
    <AssemblyName>eShopWCFService</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- CoreWCF for hosting the WCF service on ASP.NET Core -->
    <PackageReference Include="CoreWCF.Http" Version="1.9.1" />
    <PackageReference Include="CoreWCF.Primitives" Version="1.9.1" />
    <!-- EF Core for .NET 10 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Exclude the legacy .svc file (replaced by Program.cs endpoint registration) -->
    <Content Remove="CatalogService.svc" />
    <None Include="CatalogService.svc" />
    <!-- Exclude CatalogServiceClient (WCF client inside server project — not needed) -->
    <Compile Remove="CatalogServiceClient.cs" />
  </ItemGroup>
</Project>
