<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>eShopWCFService</RootNamespace>
    <AssemblyName>eShopWCFService</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CoreWCF.Http" Version="1.9.1" />
    <PackageReference Include="CoreWCF.Primitives" Version="1.9.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <!-- Override transitive vulnerable version from CoreWCF -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <!-- Exclude legacy IIS/WCF hosting files replaced by Program.cs -->
  <ItemGroup>
    <Content Remove="CatalogService.svc" />
    <None Remove="Web.config" />
    <None Remove="Web.Debug.config" />
    <None Remove="Web.Release.config" />
    <None Remove="packages.config" />
    <!-- CatalogServiceClient.cs is a misplaced WCF client proxy; the server project uses CoreWCF -->
    <Compile Remove="CatalogServiceClient.cs" />
  </ItemGroup>

</Project>
