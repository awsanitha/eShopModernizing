<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7"/>
  </startup>
  <appSettings>
    <!--
      URL of the WCF CatalogService endpoint.
      System.ServiceModel on .NET 10 does not read <system.serviceModel> from app.config,
      so the service URL is configured here and read via ConfigurationManager.AppSettings.
    -->
    <add key="ServiceUrl" value="http://localhost:62314/CatalogService.svc" />
  </appSettings>
</configuration>
