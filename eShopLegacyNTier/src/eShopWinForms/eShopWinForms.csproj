<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <AssemblyName>eShopWinForms</AssemblyName>
    <RootNamespace>eShopWinForms</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceModel.Http" Version="8.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Exclude UWP/WinRT helper files that are not used by this WinForms project -->
  <ItemGroup>
    <Compile Remove="Helpers\SettingsStorageExtensions.cs" />
    <Compile Remove="Helpers\NotificationsHelper.cs" />
    <Compile Remove="Helpers\UploadImageHelper.cs" />
    <Compile Remove="Helpers\DependencyObjectExtensions.cs" />
    <Compile Remove="Helpers\ResourceExtensions.cs" />
    <Compile Remove="Helpers\Json.cs" />
    <Compile Remove="Helpers\Singleton.cs" />
  </ItemGroup>

</Project>
