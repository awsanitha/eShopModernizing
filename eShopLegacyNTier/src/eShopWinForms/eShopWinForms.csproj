<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>eShopWinForms</RootNamespace>
    <AssemblyName>eShopWinForms</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Suppress CS0169 for unused private fields in auto-generated WinForms designer code -->
    <NoWarn>$(NoWarn);CS0169</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WCF client packages for .NET 10 -->
    <PackageReference Include="System.ServiceModel.Http" Version="8.1.0" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="8.1.0" />
    <!-- JSON helper -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude UWP-specific helper files that have no WinForms equivalent -->
    <Compile Remove="Helpers\SettingsStorageExtensions.cs" />
    <Compile Remove="Helpers\NotificationsHelper.cs" />
    <Compile Remove="Helpers\DependencyObjectExtensions.cs" />
    <Compile Remove="Helpers\ResourceExtensions.cs" />
    <Compile Remove="Helpers\UploadImageHelper.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded resources -->
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Views\CatalogView.resx">
      <DependentUpon>CatalogView.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- WCF metadata files as None -->
    <None Include="Connected Services\eShopServiceReference\CatalogService.wsdl" />
    <None Include="Connected Services\eShopServiceReference\CatalogService.xsd" />
    <None Include="Connected Services\eShopServiceReference\CatalogService1.xsd" />
    <None Include="Connected Services\eShopServiceReference\CatalogService2.xsd" />
    <None Include="Connected Services\eShopServiceReference\CatalogService3.xsd" />
    <None Include="Connected Services\eShopServiceReference\Reference.svcmap" />
    <None Include="Connected Services\eShopServiceReference\configuration.svcinfo" />
    <None Include="Connected Services\eShopServiceReference\configuration91.svcinfo" />
    <None Include="Connected Services\eShopServiceReference\CatalogService.disco" />
  </ItemGroup>

</Project>
