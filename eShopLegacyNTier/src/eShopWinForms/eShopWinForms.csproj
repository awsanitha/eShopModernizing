<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>eShopWinForms</RootNamespace>
    <AssemblyName>eShopWinForms</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Required to build Windows-targeting projects on non-Windows CI/build environments -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Suppress CA1416 platform-compatibility warnings: this project is inherently Windows-only (WinForms) -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!-- Exclude UWP-only helper files and unused auto-generated settings -->
  <ItemGroup>
    <Compile Remove="Helpers\**" />
    <Compile Remove="Properties\Settings.Designer.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- WCF client support on modern .NET -->
    <PackageReference Include="System.ServiceModel.Http" Version="8.1.2" />
  </ItemGroup>
</Project>
