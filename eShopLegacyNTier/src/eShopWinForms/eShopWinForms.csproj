<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>eShopWinForms</RootNamespace>
    <AssemblyName>eShopWinForms</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon />
    <!-- Required to cross-compile a Windows-targeted project on Linux -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!--
      CA1416 "platform compatibility" warnings are expected for a Windows-only WinForms
      app when compiled on Linux. The entire binary targets net10.0-windows so these
      warnings do not represent a real portability risk.
      CS0169 "field is never used" fires on auto-generated WinForms designer fields that
      are accessed through designer infrastructure; suppressing is correct here.
    -->
    <NoWarn>$(NoWarn);CA1416;CS0169</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Exclude UWP-specific helpers (Windows.Storage, Windows.UI.*, Windows.ApplicationModel.*).
      These files are leftover from a UWP version of the app and are not used anywhere
      in the WinForms codebase; they cannot compile against net10.0-windows WinForms target.
    -->
    <Compile Remove="Helpers\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- WCF client packages — keep using System.ServiceModel namespace on the client side -->
    <PackageReference Include="System.ServiceModel.Primitives" Version="8.1.0" />
    <PackageReference Include="System.ServiceModel.Http" Version="8.1.0" />
    <!-- Required for Settings.Designer.cs ApplicationSettingsBase and ConfigurationManager -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="App.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
