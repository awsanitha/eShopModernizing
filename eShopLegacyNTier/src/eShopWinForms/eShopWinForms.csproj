<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>eShopWinForms</RootNamespace>
    <AssemblyName>eShopWinForms</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- CA1416 platform-compatibility warnings are expected false-positives for a
         Windows-only WinForms application; suppress them project-wide. -->
    <!-- CS0169 unused-field warnings come from auto-generated WinForms Designer code. -->
    <NoWarn>$(NoWarn);CA1416;CS0169</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WCF client packages for .NET 10 -->
    <PackageReference Include="System.ServiceModel.Http" Version="8.1.0" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="8.1.0" />
    <!-- JSON serialization -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Exclude UWP-specific helper files that are not compatible with WinForms on .NET 10 -->
  <ItemGroup>
    <Compile Remove="Helpers\UploadImageHelper.cs" />
    <Compile Remove="Helpers\SettingsStorageExtensions.cs" />
    <Compile Remove="Helpers\DependencyObjectExtensions.cs" />
    <Compile Remove="Helpers\NotificationsHelper.cs" />
    <Compile Remove="Helpers\ResourceExtensions.cs" />
    <Compile Remove="Helpers\Singleton.cs" />
    <Compile Remove="Helpers\Json.cs" />
  </ItemGroup>

  <!-- Exclude old framework configuration files -->
  <ItemGroup>
    <None Remove="packages.config" />
  </ItemGroup>

</Project>
