<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>eShopWinForms</RootNamespace>
    <AssemblyName>eShopWinForms</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Required when building Windows-targeting projects on non-Windows platforms -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Suppress CA1416: the entire project targets net10.0-windows and is Windows-only.
         Suppress CS0169: unused private fields in designer-generated code. -->
    <NoWarn>$(NoWarn);CA1416;CS0169</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceModel.Http" Version="8.1.0" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="8.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude UWP-specific helper files that are not compatible with WinForms .NET 10 -->
    <Compile Remove="Helpers\**" />
    <!-- Exclude legacy packages.config -->
    <None Remove="packages.config" />
    <!-- Exclude .svcmap and other WCF metadata files from build -->
    <None Remove="Connected Services\eShopServiceReference\Reference.svcmap" />
  </ItemGroup>
</Project>
