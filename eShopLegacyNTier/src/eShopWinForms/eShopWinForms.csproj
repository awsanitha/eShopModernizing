<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>eShopWinForms</RootNamespace>
    <AssemblyName>eShopWinForms</AssemblyName>
    <!-- Required to build Windows-targeted projects on non-Windows systems (e.g. Linux CI) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Suppress CA1416: this project targets net10.0-windows (Windows-only by design).
         All WinForms API call sites are correctly platform-guarded by the TFM. -->
    <!-- Suppress CS0169: auto-generated Designer.cs declares private fields that are
         intentionally unused (WinForms backwards-compatibility stubs). -->
    <NoWarn>CA1416;CS0169</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- WCF client packages for consuming the WCF service -->
    <PackageReference Include="System.ServiceModel.Http" Version="8.1.0" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="8.1.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Exclude UWP-only helper files (not applicable to WinForms) -->
    <Compile Remove="Helpers\NotificationsHelper.cs" />
    <Compile Remove="Helpers\SettingsStorageExtensions.cs" />
    <Compile Remove="Helpers\DependencyObjectExtensions.cs" />
    <Compile Remove="Helpers\ResourceExtensions.cs" />
    <Compile Remove="Helpers\UploadImageHelper.cs" />
    <Compile Remove="Helpers\Json.cs" />
  </ItemGroup>
</Project>
