<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>eShopWinForms</AssemblyName>
    <RootNamespace>eShopWinForms</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Allow building Windows-targeted project on Linux (CI / dev containers) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude legacy AssemblyInfo – SDK auto-generates it -->
    <Compile Remove="Properties\AssemblyInfo.cs" />
    <!-- Exclude UWP-specific helper files (Windows.UI, Windows.ApplicationModel, etc.)
         These are leftover from a UWP version and not used by the WinForms application. -->
    <Compile Remove="Helpers\ResourceExtensions.cs" />
    <Compile Remove="Helpers\UploadImageHelper.cs" />
    <Compile Remove="Helpers\NotificationsHelper.cs" />
    <Compile Remove="Helpers\DependencyObjectExtensions.cs" />
    <Compile Remove="Helpers\SettingsStorageExtensions.cs" />
    <Compile Remove="Helpers\Json.cs" />
    <!-- Exclude legacy config files -->
    <None Remove="packages.config" />
  </ItemGroup>

  <ItemGroup>
    <!-- WCF client packages – runtime-independent, versioned separately from .NET -->
    <PackageReference Include="System.ServiceModel.Primitives" Version="8.1.0" />
    <PackageReference Include="System.ServiceModel.Http" Version="8.1.0" />
    <!-- JSON serialization -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Views\CatalogView.resx">
      <DependentUpon>CatalogView.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

</Project>
