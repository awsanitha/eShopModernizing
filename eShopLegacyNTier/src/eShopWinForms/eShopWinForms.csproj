<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>eShopWinForms</RootNamespace>
    <AssemblyName>eShopWinForms</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Allow building net10.0-windows on Linux (CI environments) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Declare minimum supported Windows version to suppress CA1416 for WinForms APIs -->
    <SupportedOSPlatformVersion>6.1</SupportedOSPlatformVersion>
    <!-- Suppress CS0169 (unused private fields) for auto-generated Designer.cs files -->
    <NoWarn>$(NoWarn);CS0169</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WCF client for communicating with eShopWCFService -->
    <PackageReference Include="System.ServiceModel.Http" Version="8.1.0" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="8.1.0" />
    <!-- System.Drawing.Common for Image operations in WinForms -->
    <!-- System.Configuration.ConfigurationManager for ApplicationSettingsBase in Settings.Designer.cs -->
    <!-- Newtonsoft.Json used by Helpers/Json.cs (excluded from compile but retained for future use) -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Exclude UWP helper files — they use Windows.Storage and Windows.UI.Xaml APIs
       which are incompatible with WinForms on .NET 10. These files are not used
       by any WinForms code (they use the namespace eShop.UWP.Helpers). -->
  <ItemGroup>
    <Compile Remove="Helpers\UploadImageHelper.cs" />
    <Compile Remove="Helpers\SettingsStorageExtensions.cs" />
    <Compile Remove="Helpers\DependencyObjectExtensions.cs" />
    <Compile Remove="Helpers\ResourceExtensions.cs" />
    <Compile Remove="Helpers\Singleton.cs" />
    <Compile Remove="Helpers\Json.cs" />
    <Compile Remove="Helpers\NotificationsHelper.cs" />
  </ItemGroup>

  <!-- Embedded resources for the form -->
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Views\CatalogView.resx">
      <DependentUpon>CatalogView.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

</Project>
