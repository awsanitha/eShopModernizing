<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>eShopLegacyMVC</RootNamespace>
    <AssemblyName>eShopLegacyMVC</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Autofac" Version="8.3.0" />
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="log4net" Version="2.0.17" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.6" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\eShopLegacy.Utilities\eShopLegacy.Utilities.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Exclude legacy .NET Framework files not needed for ASP.NET Core -->
    <Compile Remove="Global.asax.cs" />
    <Compile Remove="App_Start\BundleConfig.cs" />
    <Compile Remove="App_Start\FilterConfig.cs" />
    <Compile Remove="App_Start\RouteConfig.cs" />
    <Compile Remove="App_Start\WebApiConfig.cs" />
    <Content Remove="Global.asax" />
    <Content Remove="Web.config" />
    <Content Remove="Web.Debug.config" />
    <Content Remove="Web.Release.config" />
    <Content Remove="Views\Web.config" />
    <Content Remove="ApplicationInsights.config" />
  </ItemGroup>
  <ItemGroup>
    <!-- Static content moved to wwwroot -->
    <None Include="Setup\CatalogBrands.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Setup\CatalogItems.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Setup\CatalogTypes.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Setup\CatalogItems.zip" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
