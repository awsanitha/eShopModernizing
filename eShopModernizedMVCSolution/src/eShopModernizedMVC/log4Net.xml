<log4net>
  <root>
    <level value="ALL" />
    <appender-ref ref="consoleAppender" />
  </root>

  <!-- Application Insights telemetry is now wired via AddApplicationInsightsTelemetry() in Program.cs DI,
       so the legacy log4net ApplicationInsights/Azure appenders are no longer required. -->
  <appender name="consoleAppender" type="log4net.Appender.ConsoleAppender">
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%thread] %level %logger - %message%newline" />
    </layout>
  </appender>

</log4net>
