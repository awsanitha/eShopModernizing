@if (User.Identity?.IsAuthenticated ?? false)
{
    <div class="esh-identity">
        <span class="esh-identity-name">@User.Identity.Name</span>
        <a href="@Url.Action("SignOut", "Account")" class="esh-identity-item">Sign out</a>
    </div>
}
else
{
    <div class="esh-identity">
        <a href="@Url.Action("SignIn", "Account")" class="esh-identity-item">Sign in</a>
    </div>
}
