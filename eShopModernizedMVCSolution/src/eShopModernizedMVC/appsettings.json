{
  "ConnectionStrings": {
    "CatalogDBContext": "Server=(localdb)\\mssqllocaldb;Initial Catalog=Microsoft.eShopOnContainers.Services.CatalogDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "UseMockData": true,
  "UseCustomizationData": false,
  "StorageConnectionString": "#YourAzureStorageCatalogConnectionString#",
  "UseAzureManagedIdentity": false,
  "UseAzureStorage": false,
  "UseAzureActiveDirectory": false,
  "AzureActiveDirectoryClientId": "[Enter client ID as obtained from Azure Portal, e.g. 82692da5-a86f-44c9-9d53-2f88d52b478b]",
  "AzureActiveDirectoryTenant": "[Enter tenant name, e.g. contoso.onmicrosoft.com]",
  "AzureActiveDirectoryInstance": "https://login.microsoftonline.com/{0}",
  "PostLogoutRedirectUri": "https://localhost:44321/",
  "AppInsightsInstrumentationKey": ""
}
