<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>eShopModernizedWebForms</RootNamespace>
    <AssemblyName>eShopModernizedWebForms</AssemblyName>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Autofac" Version="8.0.0" />
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="log4net" Version="2.0.17" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.24.0" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.22.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- WebForms specific files are not compiled under .NET Core/.NET 10 -->
    <Compile Remove="**/*.aspx.cs" />
    <Compile Remove="**/*.aspx.designer.cs" />
    <Compile Remove="**/*.ascx.cs" />
    <Compile Remove="**/*.ascx.designer.cs" />
    <Compile Remove="**/*.asmx.cs" />
    <Compile Remove="**/*.master.cs" />
    <Compile Remove="**/*.master.designer.cs" />
    <Compile Remove="Global.asax.cs" />
    <Compile Remove="App_Start/**/*.cs" />
    <Compile Remove="Properties/**/*.cs" />
    <Compile Remove="Middleware/**/*.cs" />
    <Compile Remove="Startup.cs" />

    <Content Remove="**/*.aspx" />
    <Content Remove="**/*.ascx" />
    <Content Remove="**/*.asmx" />
    <Content Remove="**/*.master" />
    <Content Remove="Global.asax" />
    <Content Remove="Web.config" />
    <Content Remove="Web.Debug.config" />
    <Content Remove="Web.Release.config" />
    <Content Remove="Bundle.config" />
    <Content Remove="Dockerfile" />

    <None Remove="**/*.aspx" />
    <None Remove="**/*.ascx" />
    <None Remove="**/*.asmx" />
    <None Remove="**/*.master" />
  </ItemGroup>

</Project>
