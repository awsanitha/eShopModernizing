<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>eShopModernizedWebForms</RootNamespace>
    <AssemblyName>eShopModernizedWebForms</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- Exclude all WebForms-specific files (.aspx, .ascx, .Master code-behind) -->
  <ItemGroup>
    <Compile Remove="Global.asax.cs" />
    <Compile Remove="App_Start\BundleConfig.cs" />
    <Compile Remove="App_Start\RouteConfig.cs" />
    <Compile Remove="App_Start\Startup.Auth.cs" />
    <Compile Remove="App_Start\OptionalKeyVaultConfigurationBuilder.cs" />
    <Compile Remove="Default.aspx.cs" />
    <Compile Remove="Default.aspx.designer.cs" />
    <Compile Remove="Site.Master.cs" />
    <Compile Remove="Site.Master.designer.cs" />
    <Compile Remove="Site.Mobile.Master.cs" />
    <Compile Remove="Site.Mobile.Master.designer.cs" />
    <Compile Remove="ViewSwitcher.ascx.cs" />
    <Compile Remove="ViewSwitcher.ascx.designer.cs" />
    <Compile Remove="Catalog\Create.aspx.cs" />
    <Compile Remove="Catalog\Create.aspx.designer.cs" />
    <Compile Remove="Catalog\Delete.aspx.cs" />
    <Compile Remove="Catalog\Delete.aspx.designer.cs" />
    <Compile Remove="Catalog\Details.aspx.cs" />
    <Compile Remove="Catalog\Details.aspx.designer.cs" />
    <Compile Remove="Catalog\Edit.aspx.cs" />
    <Compile Remove="Catalog\Edit.aspx.designer.cs" />
    <Compile Remove="Catalog\PicUploader.asmx.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Global.asax" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Autofac" Version="8.3.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.24.0" />
    <PackageReference Include="log4net" Version="2.0.17" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.22.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.73.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
