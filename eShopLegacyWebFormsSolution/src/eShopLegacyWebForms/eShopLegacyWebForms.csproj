<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>eShopLegacyWebForms</RootNamespace>
    <AssemblyName>eShopLegacyWebForms</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- Exclude legacy WebForms code-behind and designer files -->
  <ItemGroup>
    <Compile Remove="About.aspx.cs" />
    <Compile Remove="About.aspx.designer.cs" />
    <Compile Remove="Contact.aspx.cs" />
    <Compile Remove="Contact.aspx.designer.cs" />
    <Compile Remove="Default.aspx.cs" />
    <Compile Remove="Default.aspx.designer.cs" />
    <Compile Remove="Catalog\Create.aspx.cs" />
    <Compile Remove="Catalog\Create.aspx.designer.cs" />
    <Compile Remove="Catalog\Edit.aspx.cs" />
    <Compile Remove="Catalog\Edit.aspx.designer.cs" />
    <Compile Remove="Catalog\Delete.aspx.cs" />
    <Compile Remove="Catalog\Delete.aspx.designer.cs" />
    <Compile Remove="Catalog\Details.aspx.cs" />
    <Compile Remove="Catalog\Details.aspx.designer.cs" />
    <Compile Remove="Global.asax.cs" />
    <Compile Remove="Site.Master.cs" />
    <Compile Remove="Site.Master.designer.cs" />
    <Compile Remove="Site.Mobile.Master.cs" />
    <Compile Remove="Site.Mobile.Master.designer.cs" />
    <Compile Remove="ViewSwitcher.ascx.cs" />
    <Compile Remove="ViewSwitcher.ascx.designer.cs" />
    <Compile Remove="App_Start\BundleConfig.cs" />
    <Compile Remove="App_Start\RouteConfig.cs" />
    <Compile Remove="Modules\ApplicationModule.cs" />
    <Compile Remove="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <!-- Exclude legacy WebForms markup and config files from being picked up as Content -->
  <ItemGroup>
    <None Remove="packages.config" />
    <None Remove="Bundle.config" />
    <None Remove="Web.config" />
    <None Remove="Web.Debug.config" />
    <None Remove="Web.Release.config" />
    <None Remove="ApplicationInsights.config" />
    <None Remove="log4Net.xml" />
  </ItemGroup>

  <!-- NuGet packages -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.4">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.4">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Static content files -->
  <ItemGroup>
    <Content Include="Setup\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Models\Infrastructure\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
