<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>eShopLegacyWebForms</RootNamespace>
    <AssemblyName>eShopLegacyWebForms</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- Exclude legacy WebForms files that cannot compile on .NET Core -->
  <ItemGroup>
    <Compile Remove="Global.asax.cs" />
    <Compile Remove="App_Start\BundleConfig.cs" />
    <Compile Remove="App_Start\RouteConfig.cs" />
    <Compile Remove="Modules\ApplicationModule.cs" />
    <Compile Remove="Properties\AssemblyInfo.cs" />
    <Compile Remove="Site.Master.cs" />
    <Compile Remove="Site.Master.designer.cs" />
    <Compile Remove="Site.Mobile.Master.cs" />
    <Compile Remove="Site.Mobile.Master.designer.cs" />
    <Compile Remove="ViewSwitcher.ascx.cs" />
    <Compile Remove="ViewSwitcher.ascx.designer.cs" />
    <Compile Remove="Default.aspx.cs" />
    <Compile Remove="Default.aspx.designer.cs" />
    <Compile Remove="About.aspx.cs" />
    <Compile Remove="About.aspx.designer.cs" />
    <Compile Remove="Contact.aspx.cs" />
    <Compile Remove="Contact.aspx.designer.cs" />
    <Compile Remove="Catalog\Create.aspx.cs" />
    <Compile Remove="Catalog\Create.aspx.designer.cs" />
    <Compile Remove="Catalog\Edit.aspx.cs" />
    <Compile Remove="Catalog\Edit.aspx.designer.cs" />
    <Compile Remove="Catalog\Details.aspx.cs" />
    <Compile Remove="Catalog\Details.aspx.designer.cs" />
    <Compile Remove="Catalog\Delete.aspx.cs" />
    <Compile Remove="Catalog\Delete.aspx.designer.cs" />
  </ItemGroup>

  <!-- Exclude legacy WebForms markup files from being processed as content -->
  <ItemGroup>
    <Content Remove="Global.asax" />
    <Content Remove="Web.config" />
    <Content Remove="Web.Debug.config" />
    <Content Remove="Web.Release.config" />
    <Content Remove="Bundle.config" />
    <Content Remove="packages.config" />
    <Content Remove="Site.Master" />
    <Content Remove="Site.Mobile.Master" />
    <Content Remove="ViewSwitcher.ascx" />
    <Content Remove="Default.aspx" />
    <Content Remove="About.aspx" />
    <Content Remove="Contact.aspx" />
    <Content Remove="Catalog\Create.aspx" />
    <Content Remove="Catalog\Edit.aspx" />
    <Content Remove="Catalog\Details.aspx" />
    <Content Remove="Catalog\Delete.aspx" />
    <Content Remove="ApplicationInsights.config" />
    <Content Remove="log4Net.xml" />
  </ItemGroup>

  <!-- Static assets served from wwwroot -->
  <ItemGroup>
    <None Remove="Content\**" />
    <None Remove="Scripts\**" />
    <None Remove="fonts\**" />
    <None Remove="images\**" />
    <None Remove="Pics\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" Version="8.3.0" />
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.6">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

  </ItemGroup>

</Project>
