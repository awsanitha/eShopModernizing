<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>eShopLegacyWebForms</RootNamespace>
    <AssemblyName>eShopLegacyWebForms</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core Razor Pages -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.0" />

    <!-- EF Core -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Logging: Microsoft.Extensions.Logging is included transitively via the Web SDK -->
    <!-- log4net is excluded - using built-in Microsoft.Extensions.Logging instead -->

    <!-- JSON -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Exclude legacy WebForms files that are not part of the new app -->
  <ItemGroup>
    <Compile Remove="App_Start\BundleConfig.cs" />
    <Compile Remove="App_Start\RouteConfig.cs" />
    <Compile Remove="Global.asax.cs" />
    <Compile Remove="Modules\ApplicationModule.cs" />
    <Compile Remove="About.aspx.cs" />
    <Compile Remove="About.aspx.designer.cs" />
    <Compile Remove="Contact.aspx.cs" />
    <Compile Remove="Contact.aspx.designer.cs" />
    <Compile Remove="Default.aspx.cs" />
    <Compile Remove="Default.aspx.designer.cs" />
    <Compile Remove="Catalog\Create.aspx.cs" />
    <Compile Remove="Catalog\Create.aspx.designer.cs" />
    <Compile Remove="Catalog\Edit.aspx.cs" />
    <Compile Remove="Catalog\Edit.aspx.designer.cs" />
    <Compile Remove="Catalog\Delete.aspx.cs" />
    <Compile Remove="Catalog\Delete.aspx.designer.cs" />
    <Compile Remove="Catalog\Details.aspx.cs" />
    <Compile Remove="Catalog\Details.aspx.designer.cs" />
    <Compile Remove="Site.Master.cs" />
    <Compile Remove="Site.Master.designer.cs" />
    <Compile Remove="Site.Mobile.Master.cs" />
    <Compile Remove="Site.Mobile.Master.designer.cs" />
    <Compile Remove="ViewSwitcher.ascx.cs" />
    <Compile Remove="ViewSwitcher.ascx.designer.cs" />
    <Compile Remove="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <!-- Exclude legacy WebForms markup/config files from being served -->
  <ItemGroup>
    <None Include="Global.asax" />
    <None Include="Bundle.config" />
    <None Include="Web.config" />
    <None Include="Web.Debug.config" />
    <None Include="Web.Release.config" />
  </ItemGroup>

  <ItemGroup>
    <!-- Static content served from wwwroot -->
    <Content Update="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
