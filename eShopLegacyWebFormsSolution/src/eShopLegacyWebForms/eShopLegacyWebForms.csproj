<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Autofac" Version="8.3.0" />
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="log4net" Version="3.3.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <ItemGroup>
    <!-- Exclude legacy Web Forms files -->
    <Compile Remove="App_Start\BundleConfig.cs" />
    <Compile Remove="App_Start\RouteConfig.cs" />
    <Compile Remove="Global.asax.cs" />
    <Content Remove="Global.asax" />
    <Compile Remove="Default.aspx.cs" />
    <Compile Remove="Default.aspx.designer.cs" />
    <Compile Remove="About.aspx.cs" />
    <Compile Remove="About.aspx.designer.cs" />
    <Compile Remove="Contact.aspx.cs" />
    <Compile Remove="Contact.aspx.designer.cs" />
    <Compile Remove="Catalog\Create.aspx.cs" />
    <Compile Remove="Catalog\Create.aspx.designer.cs" />
    <Compile Remove="Catalog\Edit.aspx.cs" />
    <Compile Remove="Catalog\Edit.aspx.designer.cs" />
    <Compile Remove="Catalog\Delete.aspx.cs" />
    <Compile Remove="Catalog\Delete.aspx.designer.cs" />
    <Compile Remove="Catalog\Details.aspx.cs" />
    <Compile Remove="Catalog\Details.aspx.designer.cs" />
    <Compile Remove="Site.Master.cs" />
    <Compile Remove="Site.Master.designer.cs" />
    <Compile Remove="Site.Mobile.Master.cs" />
    <Compile Remove="Site.Mobile.Master.designer.cs" />
    <Compile Remove="ViewSwitcher.ascx.cs" />
    <Compile Remove="ViewSwitcher.ascx.designer.cs" />
    <!-- Exclude Web.config files -->
    <Content Remove="Web.config" />
    <Content Remove="Web.Debug.config" />
    <Content Remove="Web.Release.config" />
    <!-- Exclude ApplicationInsights.config -->
    <Content Remove="ApplicationInsights.config" />
    <!-- Exclude Bundle.config -->
    <Content Remove="Bundle.config" />
    <!-- Exclude packages.config -->
    <None Remove="packages.config" />
  </ItemGroup>
</Project>
