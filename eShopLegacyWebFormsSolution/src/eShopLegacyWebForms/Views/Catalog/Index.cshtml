@model eShopLegacyWebForms.ViewModel.PaginatedItemsViewModel<eShopLegacyWebForms.Models.CatalogItem>

@{
    ViewData["Title"] = "Home Page";
}

<div class="esh-table">
    <p class="esh-link-wrapper">
        <a asp-route="CreateProductRoute" class="btn esh-button esh-button-primary">
            Create New
        </a>
    </p>

    @if (Model.Data != null && Model.Data.Any())
    {
        <table class="table">
            <thead>
                <tr class="esh-table-header">
                    <th></th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Brand</th>
                    <th>Type</th>
                    <th>Price</th>
                    <th>Picture name</th>
                    <th>Stock</th>
                    <th>Restock</th>
                    <th>Max stock</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Data)
                {
                    <tr>
                        <td>
                            <img class="esh-thumbnail" src="/Pics/@item.PictureFileName" alt="@item.Name" />
                        </td>
                        <td><p>@item.Name</p></td>
                        <td><p>@item.Description</p></td>
                        <td><p>@item.CatalogBrand?.Brand</p></td>
                        <td><p>@item.CatalogType?.Type</p></td>
                        <td><p><span class="esh-price">@item.Price</span></p></td>
                        <td><p>@item.PictureFileName</p></td>
                        <td><p>@item.AvailableStock</p></td>
                        <td><p>@item.RestockThreshold</p></td>
                        <td><p>@item.MaxStockThreshold</p></td>
                        <td>
                            <a asp-route="EditProductRoute" asp-route-id="@item.Id" class="esh-table-link">Edit</a>
                            |
                            <a asp-route="ProductDetailsRoute" asp-route-id="@item.Id" class="esh-table-link">Details</a>
                            |
                            <a asp-route="DeleteProductRoute" asp-route-id="@item.Id" class="esh-table-link">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <table>
            <tr><td>No data was returned.</td></tr>
        </table>
    }
</div>

<div class="esh-pager">
    <div class="container">
        <article class="esh-pager-wrapper row">
            <nav>
                @{
                    var prevStyles = Model.ActualPage > 0 ? "" : " esh-pager-item--hidden";
                    var nextStyles = Model.ActualPage < Model.TotalPages - 1 ? "" : " esh-pager-item--hidden";
                }
                <a asp-route="ProductsByPageRoute"
                   asp-route-index="@(Model.ActualPage - 1)"
                   asp-route-size="@Model.ItemsPerPage"
                   class="esh-pager-item esh-pager-item--navigable@prevStyles">
                    Previous
                </a>

                <span class="esh-pager-item">
                    Showing @Model.ItemsPerPage of @Model.TotalItems products - Page @(Model.ActualPage + 1) - @Model.TotalPages
                </span>

                <a asp-route="ProductsByPageRoute"
                   asp-route-index="@(Model.ActualPage + 1)"
                   asp-route-size="@Model.ItemsPerPage"
                   class="esh-pager-item esh-pager-item--navigable@nextStyles">
                    Next
                </a>
            </nav>
        </article>
    </div>
</div>
