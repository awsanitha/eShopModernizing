@model eShopLegacyWebForms.Models.CatalogItem
@{ ViewBag.Title = "Create"; }

<div class="container">
    <h2>Create Catalog Item</h2>
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group">
            <label asp-for="Name"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Description"></label>
            <input asp-for="Description" class="form-control" />
        </div>
        <div class="form-group">
            <label asp-for="Price"></label>
            <input asp-for="Price" class="form-control" />
        </div>
        <div class="form-group">
            <label asp-for="CatalogTypeId"></label>
            <select asp-for="CatalogTypeId" class="form-control" asp-items="ViewBag.CatalogTypeId"></select>
        </div>
        <div class="form-group">
            <label asp-for="CatalogBrandId"></label>
            <select asp-for="CatalogBrandId" class="form-control" asp-items="ViewBag.CatalogBrandId"></select>
        </div>
        <div class="form-group">
            <label asp-for="AvailableStock"></label>
            <input asp-for="AvailableStock" class="form-control" />
        </div>
        <div class="form-group">
            <label asp-for="RestockThreshold"></label>
            <input asp-for="RestockThreshold" class="form-control" />
        </div>
        <div class="form-group">
            <label asp-for="MaxStockThreshold"></label>
            <input asp-for="MaxStockThreshold" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Create</button>
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </form>
</div>
