@model eShopLegacyWebForms.Models.CatalogItem
@{ ViewBag.Title = "Details"; }

<div class="container">
    <h2>Catalog Item Details</h2>
    <dl class="dl-horizontal">
        <dt>Name</dt><dd>@Model.Name</dd>
        <dt>Description</dt><dd>@Model.Description</dd>
        <dt>Price</dt><dd>@Model.Price</dd>
        <dt>Brand</dt><dd>@Model.CatalogBrand?.Brand</dd>
        <dt>Type</dt><dd>@Model.CatalogType?.Type</dd>
    </dl>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</div>
