@model eShopLegacyWebForms.Models.CatalogItem

@{
    ViewData["Title"] = "Delete";
}

<h2 class="esh-body-title">Delete</h2>

<div class="container">
    <h3>Are you sure you want to delete this?</h3>
    <div class="row">
        <img class="col-md-6 esh-picture" src="/Pics/@Model.PictureFileName" alt="@Model.Name" />
        <dl class="col-md-6 dl-horizontal">
            <dt>Name</dt>
            <dd>@Model.Name</dd>

            <dt>Description</dt>
            <dd>@Model.Description</dd>

            <dt>Brand</dt>
            <dd>@Model.CatalogBrand?.Brand</dd>

            <dt>Type</dt>
            <dd>@Model.CatalogType?.Type</dd>

            <dt>Price</dt>
            <dd><span class="esh-price">@Model.Price</span></dd>

            <dt>Picture name</dt>
            <dd>@Model.PictureFileName</dd>

            <dt>Stock</dt>
            <dd>@Model.AvailableStock</dd>

            <dt>Restock</dt>
            <dd>@Model.RestockThreshold</dd>

            <dt>Max stock</dt>
            <dd>@Model.MaxStockThreshold</dd>

            <dt></dt>
            <dd class="text-right esh-button-actions">
                <a href="/" class="btn esh-button esh-button-secondary">[ Cancel ]</a>
                <form method="post" asp-route="DeleteProductRoute" asp-route-id="@Model.Id" asp-action="DeleteConfirmed" style="display:inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn esh-button esh-button-primary">[ Delete ]</button>
                </form>
            </dd>
        </dl>
    </div>
</div>
