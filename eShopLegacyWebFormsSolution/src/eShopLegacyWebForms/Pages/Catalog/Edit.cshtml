@page "{id:int}"
@model eShopLegacyWebForms.Pages.Catalog.EditModel
@{
    ViewData["Title"] = "Edit";
}

<h2 class="esh-body-title">Edit</h2>

<div class="container">
    <form method="post">
        <input type="hidden" asp-for="Item!.Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row">
            <img class="col-md-6 esh-picture" src="/Pics/@Model.Item?.PictureFileName" />
            <div class="col-md-6 form-horizontal">

                <div class="form-group">
                    <label class="control-label col-md-4">Name</label>
                    <div class="col-md-8">
                        <input asp-for="Item!.Name" class="form-control" />
                        <span asp-validation-for="Item!.Name" class="field-validation-valid text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-4">Description</label>
                    <div class="col-md-8">
                        <input asp-for="Item!.Description" class="form-control" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-4">Brand</label>
                    <div class="col-md-8">
                        <select asp-for="Item!.CatalogBrandId" asp-items="Model.BrandSelectList" class="form-control"></select>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-4">Type</label>
                    <div class="col-md-8">
                        <select asp-for="Item!.CatalogTypeId" asp-items="Model.TypeSelectList" class="form-control"></select>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-4">Price</label>
                    <div class="col-md-8">
                        <input asp-for="Item!.Price" class="form-control" />
                        <span asp-validation-for="Item!.Price" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-4">Picture name</label>
                    <div class="col-md-8">
                        <input asp-for="Item!.PictureFileName" class="form-control" readonly title="Not allowed for edition" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-4">Stock</label>
                    <div class="col-md-8">
                        <input asp-for="Item!.AvailableStock" class="form-control" />
                        <span asp-validation-for="Item!.AvailableStock" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-4">Restock</label>
                    <div class="col-md-8">
                        <input asp-for="Item!.RestockThreshold" class="form-control" />
                        <span asp-validation-for="Item!.RestockThreshold" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-4">Max stock</label>
                    <div class="col-md-8">
                        <input asp-for="Item!.MaxStockThreshold" class="form-control" />
                        <span asp-validation-for="Item!.MaxStockThreshold" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-12 text-right esh-button-actions">
                        <a href="/" class="btn esh-button esh-button-secondary">[ Cancel ]</a>
                        <button type="submit" class="btn esh-button esh-button-primary">[ Save ]</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
