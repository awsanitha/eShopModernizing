@page
@model IndexModel
@{
    ViewData["Title"] = "Home Page";
}

<div class="esh-table">
    <p class="esh-link-wrapper">
        <a asp-page="/Catalog/Create" class="btn esh-button esh-button-primary">
            Create New
        </a>
    </p>

    @if (!Model.CatalogModel.Data.Any())
    {
        <table>
            <tr>
                <td>No data was returned.</td>
            </tr>
        </table>
    }
    else
    {
        <table class="table">
            <thead>
                <tr class="esh-table-header">
                    <th></th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Brand</th>
                    <th>Type</th>
                    <th>Price</th>
                    <th>Picture name</th>
                    <th>Stock</th>
                    <th>Restock</th>
                    <th>Max stock</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.CatalogModel.Data)
                {
                    <tr>
                        <td>
                            <img class="esh-thumbnail" src="/Pics/@item.PictureFileName" alt="@item.Name" />
                        </td>
                        <td>
                            <p>@item.Name</p>
                        </td>
                        <td>
                            <p>@item.Description</p>
                        </td>
                        <td>
                            <p>@item.CatalogBrand?.Brand</p>
                        </td>
                        <td>
                            <p>@item.CatalogType?.Type</p>
                        </td>
                        <td>
                            <p><span class="esh-price">@item.Price</span></p>
                        </td>
                        <td>
                            <p>@item.PictureFileName</p>
                        </td>
                        <td>
                            <p>@item.AvailableStock</p>
                        </td>
                        <td>
                            <p>@item.RestockThreshold</p>
                        </td>
                        <td>
                            <p>@item.MaxStockThreshold</p>
                        </td>
                        <td>
                            <a asp-page="/Catalog/Edit" asp-route-id="@item.Id" class="esh-table-link">Edit</a>
                            |
                            <a asp-page="/Catalog/Details" asp-route-id="@item.Id" class="esh-table-link">Details</a>
                            |
                            <a asp-page="/Catalog/Delete" asp-route-id="@item.Id" class="esh-table-link">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div class="esh-pager">
    <div class="container">
        <article class="esh-pager-wrapper row">
            <nav>
                @{
                    var prevIndex = Model.CatalogModel.ActualPage - 1;
                    var nextIndex = Model.CatalogModel.ActualPage + 1;
                    var pageSize = Model.CatalogModel.ItemsPerPage;
                    var hasPrev = Model.CatalogModel.ActualPage > 0;
                    var hasNext = Model.CatalogModel.ActualPage < Model.CatalogModel.TotalPages - 1;
                }

                @if (hasPrev)
                {
                    <a asp-page="/Index" asp-route-index="@prevIndex" asp-route-size="@pageSize" class="esh-pager-item esh-pager-item--navigable">
                        Previous
                    </a>
                }
                else
                {
                    <span class="esh-pager-item esh-pager-item--hidden">Previous</span>
                }

                <span class="esh-pager-item">
                    Showing @Model.CatalogModel.ItemsPerPage of @Model.CatalogModel.TotalItems products
                    - Page @(Model.CatalogModel.ActualPage + 1) - @Model.CatalogModel.TotalPages
                </span>

                @if (hasNext)
                {
                    <a asp-page="/Index" asp-route-index="@nextIndex" asp-route-size="@pageSize" class="esh-pager-item esh-pager-item--navigable">
                        Next
                    </a>
                }
                else
                {
                    <span class="esh-pager-item esh-pager-item--hidden">Next</span>
                }
            </nav>
        </article>
    </div>
</div>
